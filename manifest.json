{
  "manifest_version": 3,
  "name": "Tracked - Roblox Route Optimizer",
  "version": "1.9.6",
  "description": "Roblox için en yakın sunucuyu bul, gerçek ping ölç, bölge & VPN tespiti, Sunucu Bekçisi, müzik widget, trade analizi ve temalar.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "notifications",
    "sidePanel",
    "windows"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cors_fix",
        "enabled": true,
        "path": "cors_rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://*.rbxcdn.com/*",
    "https://*.amazonaws.com/*",
    "https://*.cloudflare.com/*",
    "https://www.google.com/*",
    "https://*.geojs.io/*",
    "https://ipapi.co/*",
    "https://ipinfo.io/*",
    "https://ipwho.is/*",
    "https://*.rolimons.com/*",
    "https://api.lemonsqueezy.com/*",
    "https://*.youtube.com/*",
    "https://*.spotify.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://trello.com/*",
    "https://*.trello.com/*",
    "https://*.trellousercontent.com/*",
    "https://*.duckduckgo.com/*",
    "https://trellofinder.com/*",
    "https://*.trellofinder.com/*",
    "https://progameguides.com/*",
    "https://*.progameguides.com/*",
    "https://beebom.com/*",
    "https://*.beebom.com/*",
    "https://gamertweak.com/*",
    "https://*.gamertweak.com/*",
    "https://mrguider.org/*",
    "https://*.mrguider.org/*",
    "https://twinfinite.net/*",
    "https://*.twinfinite.net/*",
    "https://fossbytes.com/*",
    "https://*.fossbytes.com/*",
    "https://tryhardguides.com/*",
    "https://*.tryhardguides.com/*",
    "https://gamingintel.com/*",
    "https://*.gamingintel.com/*",
    "https://gameriv.com/*",
    "https://*.gameriv.com/*",
    "https://pcgamesn.com/*",
    "https://*.pcgamesn.com/*",
    "https://ginx.tv/*",
    "https://*.ginx.tv/*",
    "https://www.ecosia.org/*",
    "https://*.ecosia.org/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tracked v1.9.6",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/flags/*.svg"
      ],
      "matches": [
        "https://www.roblox.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "themes_critical.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/games/*"
      ],
      "css": [
        "content_styles.css",
        "lib/flags.css"
      ],
      "js": [
        "tracked_debug.js",
        "license_client.js",
        "config.js",
        "lib/flags.js",
        "utils.js",
        "scanner.js",
        "ui.js",
        "i18n.js",
        "main.js",
        "themes_content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/games/*"
      ],
      "js": [
        "tracked_debug.js",
        "recent_games_content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "exclude_matches": [
        "https://www.roblox.com/games/*"
      ],
      "css": [
        "content_styles.css"
      ],
      "js": [
        "tracked_debug.js",
        "license_client.js",
        "reconnect_overlay.js",
        "themes_content.js",
        "now_playing.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/games/*"
      ],
      "js": [
        "tracked_debug.js",
        "license_client.js",
        "reconnect_overlay.js",
        "now_playing.js",
        "codes_content.js",
        "trello_panel.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/users/*/inventory*",
        "https://www.roblox.com/users/inventory*"
      ],
      "js": [
        "tracked_debug.js",
        "license_client.js",
        "inventory_rac.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/users/*/profile*"
      ],
      "js": [
        "tracked_debug.js",
        "i18n.js",
        "profile_insight.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/catalog/*"
      ],
      "js": [
        "tracked_debug.js",
        "catalog_enhancer.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/my/avatar*",
        "https://www.roblox.com/users/*/avatar*"
      ],
      "js": [
        "tracked_debug.js",
        "avatar_cost.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.roblox.com/my/avatar*"
      ],
      "js": [
        "tracked_debug.js",
        "avatar_sandbox.js"
      ],
      "run_at": "document_end"
    }
  ]
}
